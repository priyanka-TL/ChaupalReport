# =============================================================
# LLM Provider Selection
# Pick ONE provider and fill in its credentials below.
# Options: gemini | openrouter | claude
# =============================================================
LLM_PROVIDER=gemini

# =============================================================
# PROVIDER: gemini (direct Google Generative AI API)
# =============================================================
GEMINI_API_KEY=your-gemini-api-key-here
# Available models:
#   gemini-2.5-flash  (recommended, fast + cheap)
#   gemini-2.5-pro
#   gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# =============================================================
# PROVIDER: openrouter (access any model via OpenRouter)
# Get your key at https://openrouter.ai/keys
# =============================================================
# OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
# Available models (see https://openrouter.ai/models):
#   google/gemini-2.5-flash  (Gemini via OpenRouter)
#   google/gemini-2.0-flash
#   anthropic/claude-3.5-sonnet
#   meta-llama/llama-3.1-70b-instruct
# OPENROUTER_MODEL=google/gemini-2.5-flash

# =============================================================
# PROVIDER: claude (AWS Bedrock)
# =============================================================
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=ap-south-1
# CLAUDE_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# CLAUDE_MODEL_VERSION=bedrock-2023-05-31

# =============================================================
# Optional: logging
# =============================================================
# LLM_CALL_LOG_FILE=ai_calls.log
